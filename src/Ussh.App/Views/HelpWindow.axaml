<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ussh.App.Views.HelpWindow"
        Title="zSSH help"
        Width="760" Height="720" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,18,0,6" />
    </Style>
    <Style Selector="TextBlock.key">
      <Setter Property="FontFamily" Value="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,3,16,3" />
      <Setter Property="Foreground" Value="#7FC8FF" />
    </Style>
    <Style Selector="TextBlock.what">
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="16,10" Background="#10FFFFFF">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Close" IsDefault="True" IsCancel="True" Click="OnClose" MinWidth="90" />
        <Button DockPanel.Dock="Right" Content="Licences" Click="OnLicences" Margin="0,0,8,0"
                ToolTip.Tip="zSSH's licence and the licences of everything it includes" />
        <TextBlock x:Name="VersionText" VerticalAlignment="Center" Opacity="0.6" />
      </DockPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="24,8,24,24" x:Name="SectionsPanel" />
    </ScrollViewer>
  </DockPanel>
</Window>
