<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ussh.App.ViewModels"
             x:Class="Ussh.App.Views.ServersView"
             x:DataType="vm:ServersTabViewModel">
  <UserControl.Resources>
    <!-- Theme picker entry: the theme's own colours, a prompt sample and ANSI swatches. -->
    <DataTemplate x:Key="ThemeOptionTemplate" DataType="vm:ThemeOption">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Background="{Binding Background}" CornerRadius="3" Padding="8,3" Width="190">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="user@host:~$" Foreground="{Binding Foreground}" FontSize="12"
                       FontFamily="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="IBrush">
                  <Rectangle Width="5" Height="10" Fill="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid ColumnDefinitions="320,Auto,*">

    <!-- Server list -->
    <DockPanel Grid.Column="0" Margin="12">
      <TextBox DockPanel.Dock="Top" Watermark="Search servers" Text="{Binding Filter}" Margin="0,0,0,8" />
      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="Browse files" Command="{Binding BrowseFilesCommand}"
                ToolTip.Tip="Open the dual-pane file browser for this server" />
        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"
                ToolTip.Tip="Ctrl+click several servers to open them side by side in one tab" />
        <UniformGrid Columns="3" ColumnSpacing="6">
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Add" Command="{Binding AddServerCommand}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Duplicate" Command="{Binding DuplicateServerCommand}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Delete" Command="{Binding DeleteServerCommand}" />
        </UniformGrid>
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Settings" Command="{Binding ShowSettingsCommand}" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="Tip: Ctrl+click several servers, then Connect, to open them side by side." />
      <ListBox x:Name="ServerList" ItemsSource="{Binding FilteredServers}" SelectedItem="{Binding SelectedServer}"
               SelectionMode="Multiple" SelectionChanged="OnServerSelectionChanged"
               DoubleTapped="OnServerDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ServerItemViewModel">
            <StackPanel Spacing="2" Margin="0,2">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Group}" IsVisible="{Binding HasGroup}" FontSize="11" Classes="muted" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Background="#304A90E2" CornerRadius="3" Padding="4,0" IsVisible="{Binding KindBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{Binding KindBadge}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Address}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Text="{Binding Via}" FontSize="11" Classes="muted" IsVisible="{Binding HasVia}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding TunnelBadge}" FontSize="11" Classes="muted" IsVisible="{Binding TunnelBadge, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <Border Grid.Column="1" Width="1" Background="#20FFFFFF" />

    <!-- Empty state -->
    <StackPanel Grid.Column="2" IsVisible="{Binding ShowEmptyHint}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
      <TextBlock Classes="h1" Text="Server management" HorizontalAlignment="Center" />
      <TextBlock Classes="muted" Text="Select a server to edit it, double-click to connect, or Add a new one." HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Server editor -->
    <ScrollViewer Grid.Column="2" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Margin="24,16" MaxWidth="820" HorizontalAlignment="Left" Spacing="6" DataContext="{Binding Editor}" x:DataType="vm:ServerEditorViewModel">
        <DockPanel>
          <!-- Viewing: an Edit button. Editing: Cancel / Save. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="View only" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding !IsEditing}" />
            <Button Classes="accent" Content="Edit" IsVisible="{Binding !IsEditing}"
                    Command="{Binding $parent[UserControl].((vm:ServersTabViewModel)DataContext).EditServerCommand}"
                    ToolTip.Tip="Change this server's settings" />
            <TextBlock Text="Unsaved changes" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
            <Button Content="Cancel" IsVisible="{Binding IsEditing}"
                    Command="{Binding $parent[UserControl].((vm:ServersTabViewModel)DataContext).RevertServerCommand}"
                    ToolTip.Tip="Discard changes" />
            <Button Classes="accent" Content="Save" IsVisible="{Binding IsEditing}"
                    Command="{Binding $parent[UserControl].((vm:ServersTabViewModel)DataContext).SaveServerCommand}" HotKey="Ctrl+S" />
          </StackPanel>
          <TextBlock Classes="h1" Text="{Binding Heading}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock Classes="error" Text="{Binding ValidationError}" IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- The form: read-only (but readable) until Edit is pressed. -->
        <StackPanel Spacing="6" IsEnabled="{Binding IsEditing}">
          <StackPanel.Resources>
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#60FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxForegroundCheckedDisabled" Color="#E6FFFFFF" />
          </StackPanel.Resources>
        <TextBlock Classes="h2" Text="Connection" />
        <Grid ColumnDefinitions="160,*" Margin="0,0,0,8">
          <TextBlock Classes="label" Text="Type" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBlock Classes="label" Grid.Row="0" Text="Name" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Watermark="e.g. Production web 1" />
          <TextBlock Classes="label" Grid.Row="1" Text="Group" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Group}" Watermark="Optional, e.g. Production" />
        </Grid>

        <!-- Amazon S3 -->
        <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding ShowS3Fields}">
          <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Classes="label" Grid.Row="0" Text="Bucket" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding S3Bucket}" Watermark="Leave empty to browse all buckets the keys can see" />
            <TextBlock Classes="label" Grid.Row="1" Text="Region" />
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
              <ComboBox ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding SelectedRegion}" HorizontalAlignment="Stretch"
                        MaxDropDownHeight="420" ToolTip.Tip="Where the bucket lives. With all buckets, others are found automatically." />
              <TextBox Text="{Binding CustomRegion}" IsVisible="{Binding IsCustomRegion}"
                       Watermark="Region code, e.g. eu-west-2 (Cloudflare R2: auto)" />
            </StackPanel>
            <TextBlock Classes="label" Grid.Row="2" Text="Start in folder" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding S3Prefix}" Watermark="Optional, e.g. backups/2026 (with no bucket set: my-bucket/backups)" />
            <TextBlock Classes="label" Grid.Row="3" Text="Access key ID" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding S3AccessKeyId}" Watermark="AKIA…" />
            <TextBlock Classes="label" Grid.Row="4" Text="Secret access key" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding S3SecretAccessKey}" PasswordChar="●" Watermark="Stored encrypted in the vault" />
            <TextBlock Classes="label" Grid.Row="5" Text="Custom endpoint" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding S3ServiceUrl}" Watermark="Leave empty for AWS. For S3-compatible storage, e.g. https://s3.example.com" />
          </Grid>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Use an IAM user with only the access it needs (e.g. s3:ListBucket, s3:GetObject, s3:PutObject, s3:DeleteObject). Browsing all buckets also needs s3:ListAllMyBuckets. uSSH never creates or deletes buckets." />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding ShowSshFields}" Margin="0,8,0,0">
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Classes="label" Grid.Row="0" Text="Host" />
          <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto,150" ColumnSpacing="8">
            <TextBox Text="{Binding Host}" Watermark="hostname or IP address" />
            <TextBlock Grid.Column="1" Classes="label" Text="Port" Margin="0" />
            <NumericUpDown Grid.Column="2" Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
          </Grid>
          <TextBlock Classes="label" Grid.Row="1" Text="Username" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Username}" />
          <TextBlock Classes="label" Grid.Row="2" Text="Authentication" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AuthMethods}" SelectedIndex="{Binding AuthMethodIndex}" MinWidth="200" />
        </Grid>

        <Grid ColumnDefinitions="160,*" IsVisible="{Binding IsPasswordAuth}" Margin="0,8,0,0">
          <TextBlock Classes="label" Text="Password" />
          <TextBox Grid.Column="1" PasswordChar="●" Text="{Binding Password}" Watermark="Stored encrypted in the vault" />
        </Grid>

        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="8" IsVisible="{Binding IsKeyAuth}" Margin="0,8,0,0">
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Private key" />
            <Button Content="Import file…" Command="{Binding ImportKeyCommand}" FontSize="12" />
          </StackPanel>
          <TextBox Grid.Column="1" Text="{Binding PrivateKey}" AcceptsReturn="True" TextWrapping="NoWrap"
                   Height="120" FontFamily="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace" FontSize="11"
                   Watermark="Paste an OpenSSH, PEM or PuTTY (.ppk) private key, or use Import file…" />
          <TextBlock Classes="label" Grid.Row="1" Text="Key passphrase" VerticalAlignment="Top" Margin="0,6,12,0" />
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
            <TextBox PasswordChar="●" Text="{Binding PrivateKeyPassphrase}" IsVisible="{Binding ShowStoredPassphrase}"
                     Watermark="Leave empty if the key isn't encrypted. Stored encrypted in the vault." />
            <CheckBox IsChecked="{Binding AskForPassphrase}" Content="Ask every time (never stored)" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding AskForPassphrase}"
                       Text="You'll be asked when connecting. The answer is kept in memory only: open sessions reuse it to reconnect, and new panes for this server reuse it until uSSH is locked or closed." />
          </StackPanel>
        </Grid>

        <TextBlock Classes="h2" Text="Jump host" />
        <Grid ColumnDefinitions="160,*">
          <TextBlock Classes="label" Text="Connect via" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding JumpHostOptions}" SelectedItem="{Binding SelectedJumpHost}"
                    HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Reach this server through another saved server (a bastion). That server's own credentials, host key and jump host are used for its hop, so chains work. Host and port above are as seen from the jump host." />

        <TextBlock Classes="h2" Text="Host key" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Forget" Command="{Binding ForgetHostKeyCommand}" IsVisible="{Binding HasHostKey}"
                  ToolTip.Tip="You'll be asked to verify the key again on next connect." />
          <SelectableTextBlock Text="{Binding HostKeyDisplay}" VerticalAlignment="Center" FontFamily="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace" FontSize="12" />
        </DockPanel>

        <TextBlock Classes="h2" Text="Stability" />
        <Grid ColumnDefinitions="160,140,*" RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBlock Classes="label" Text="Keepalive (seconds)" />
          <NumericUpDown Grid.Column="1" Value="{Binding KeepAliveSeconds}" Minimum="0" Maximum="600" Increment="5" FormatString="0" />
          <TextBlock Grid.Column="2" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="Keeps idle sessions alive through NAT and firewalls. 0 disables (not recommended)." />
          <TextBlock Classes="label" Grid.Row="1" Text="Connect timeout (s)" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ConnectTimeoutSeconds}" Minimum="3" Maximum="120" Increment="1" FormatString="0" />
        </Grid>
        </StackPanel>

        <!-- SSH servers only: terminal behaviour -->
        <StackPanel Spacing="6" IsVisible="{Binding ShowTerminalFields}">
        <Grid ColumnDefinitions="160,*" Margin="0,8,0,0">
          <TextBlock Classes="label" Text="Auto-reconnect" />
          <CheckBox Grid.Column="1" IsChecked="{Binding AutoReconnect}" Content="Reconnect automatically if the connection drops" />
        </Grid>
        <Grid ColumnDefinitions="160,*" Margin="0,8,0,0">
          <TextBlock Classes="label" Text="When the shell exits" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ShellExitOptions}" SelectedItem="{Binding SelectedShellExit}"
                    HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Applies when you type exit (or log out). Dropped connections and errors always keep the pane open." />

        <TextBlock Classes="h2" Text="Terminal" />
        <Grid ColumnDefinitions="160,*" Margin="0,0,0,8">
          <TextBlock Classes="label" Text="Theme" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                    ItemTemplate="{StaticResource ThemeOptionTemplate}" HorizontalAlignment="Stretch" MaxDropDownHeight="480" />
        </Grid>
        <Grid ColumnDefinitions="160,200,Auto,140" ColumnSpacing="0">
          <TextBlock Classes="label" Text="Terminal type" />
          <TextBox Grid.Column="1" Text="{Binding TerminalType}" />
          <TextBlock Grid.Column="2" Classes="label" Text="Scrollback lines" Margin="16,0,12,0" />
          <NumericUpDown Grid.Column="3" Value="{Binding ScrollbackLines}" Minimum="100" Maximum="200000" Increment="1000" FormatString="0" />
        </Grid>

        <DockPanel Margin="0,12,0,4">
          <Button DockPanel.Dock="Right" Content="Add tunnel" Command="{Binding AddTunnelCommand}" />
          <TextBlock Classes="h2" Text="Tunnels (port forwarding)" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Classes="muted" Text="Started each time this server connects. A tunnel that can't start (e.g. port in use) is reported but doesn't affect the terminal."
                   TextWrapping="Wrap" FontSize="12" />
        <ItemsControl ItemsSource="{Binding Tunnels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:TunnelEditorViewModel">
              <Border Padding="10" Margin="0,6,0,0" CornerRadius="6" Background="#0CFFFFFF">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip.Tip="Enabled" />
                    <ComboBox ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex}" Width="180" />
                    <TextBox Text="{Binding BindAddress}" Width="130" Watermark="listen address" ToolTip.Tip="Listen address" />
                    <NumericUpDown Value="{Binding BindPort}" Minimum="0" Maximum="65535" FormatString="0" Width="120" ToolTip.Tip="Listen port" />
                    <TextBlock Text="→" VerticalAlignment="Center" IsVisible="{Binding HasDestination}" />
                    <TextBox Text="{Binding DestinationHost}" Width="150" Watermark="destination host" IsVisible="{Binding HasDestination}" />
                    <NumericUpDown Value="{Binding DestinationPort}" Minimum="0" Maximum="65535" FormatString="0" Width="120" IsVisible="{Binding HasDestination}" ToolTip.Tip="Destination port" />
                    <Button Content="Remove" Command="{Binding RemoveCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Explanation}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <TextBlock Classes="h2" Text="Notes" />
        <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Settings -->
    <ScrollViewer Grid.Column="2" IsVisible="{Binding IsSettingsVisible}">
      <StackPanel Margin="24,16" MaxWidth="640" HorizontalAlignment="Left" Spacing="8">
        <TextBlock Classes="h1" Text="Settings" />
        <TextBlock Classes="error" Text="{Binding SettingsMessage}" IsVisible="{Binding SettingsMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <TextBlock Classes="h2" Text="Security" />
        <Grid ColumnDefinitions="180,140,*">
          <TextBlock Classes="label" Text="Auto-lock after (min)" />
          <NumericUpDown Grid.Column="1" Value="{Binding AutoLockMinutes}" Minimum="0" Maximum="1440" FormatString="0" />
          <TextBlock Grid.Column="2" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                     Text="0 = never. Locking hides the app; sessions keep running." />
        </Grid>

        <TextBlock Classes="h2" Text="Terminal" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Classes="label" Grid.Row="3" Text="When the shell exits" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SettingsShellExitOptions}" SelectedItem="{Binding DefaultShellExit}"
                    HorizontalAlignment="Stretch" ToolTip.Tip="Default for servers that don't set their own. Only for exit/logout, never for dropped connections." />
          <TextBlock Classes="label" Grid.Row="2" Text="Default theme" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SettingsThemeOptions}" SelectedItem="{Binding DefaultTheme}"
                    ItemTemplate="{StaticResource ThemeOptionTemplate}" HorizontalAlignment="Stretch" MaxDropDownHeight="480" />
          <TextBlock Classes="label" Text="Font family" />
          <TextBox Grid.Column="1" Text="{Binding FontFamily}" />
          <TextBlock Classes="label" Grid.Row="1" Text="Font size" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding FontSize}" Minimum="6" Maximum="48" Increment="0.5" FormatString="0.#" Width="140" HorizontalAlignment="Left" />
        </Grid>
        <Button Classes="accent" Content="Save settings" Command="{Binding SaveSettingsCommand}" Margin="0,8,0,0" />

        <TextBlock Classes="h2" Text="Change admin password" />
        <TextBox PasswordChar="●" Watermark="Current password" Text="{Binding CurrentPassword}" />
        <TextBox PasswordChar="●" Watermark="New password" Text="{Binding NewPassword}" />
        <TextBox PasswordChar="●" Watermark="Confirm new password" Text="{Binding ConfirmNewPassword}" />
        <Button Content="Change password" Command="{Binding ChangePasswordCommand}" />

        <TextBlock Classes="h2" Text="About" />
        <SelectableTextBlock Text="{Binding AppVersion}" />

        <TextBlock Classes="h2" Text="Data" />
        <SelectableTextBlock Text="{Binding VaultLocation}" Classes="muted" FontSize="12" />
        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="The vault is AES-256-GCM encrypted with a key derived from the admin password (PBKDF2-SHA256, 600,000 iterations). Back this file up; without the admin password it cannot be recovered." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
