<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template. build-msix.ps1 fills in the $(...) tokens.

  For a Microsoft Store submission, IdentityName, Publisher and PublisherDisplayName must be
  exactly the values shown in Partner Center (Product management > Product identity).
  The Store re-signs the package, so it does not need to be signed for submission.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="$(IdentityName)"
    Publisher="$(Publisher)"
    Version="$(Version)"
    ProcessorArchitecture="$(Architecture)" />

  <Properties>
    <DisplayName>ussh</DisplayName>
    <PublisherDisplayName>$(PublisherDisplayName)</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <Description>SSH client with tabs, saved servers, tunnels and long-running stable sessions.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="ussh" Executable="ussh.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ussh"
        Description="SSH client with stable long-running sessions"
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Desktop (full trust) app: required for an Avalonia/.NET Win32 app in the Store. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
